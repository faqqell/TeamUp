# Local database configuration for running the backend outside Docker.
DATABASE_URL=postgresql+psycopg://teamup:teamup@localhost:55434/teamup

# JWT settings
JWT_SECRET=local-only-secret-change-if-you-share-your-machine
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MIN=10080

# Local frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
APP_BASE_URL=http://localhost:5173

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Mailpit SMTP configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@teamup.local
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# Verification code settings
VERIFICATION_CODE_TTL_MIN=10
VERIFICATION_RESEND_SEC=60
VERIFICATION_CODE_LENGTH=6

# Post-game automation settings
POST_GAME_SCHEDULER_ENABLED=true
POST_GAME_POLL_SECONDS=60

# Required by backend startup admin sync
PRIMARY_ADMIN_EMAIL=admin@teamup.com
